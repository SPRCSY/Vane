ARG NEXT_DEPS_IMAGE=crpi-nhogexmk1j5bm5vt.cn-wulanchabu.personal.cr.aliyuncs.com/wrcloudcc/vane-next-deps:node24-lock-e5a838041f38
ARG RUNTIME_BASE_IMAGE=crpi-nhogexmk1j5bm5vt.cn-wulanchabu.personal.cr.aliyuncs.com/wrcloudcc/vane-runtime-base:node24-searxng-277d8469cdd4-slim3

FROM ${NEXT_DEPS_IMAGE} AS next-builder

WORKDIR /home/vane

COPY tsconfig.json next.config.mjs next-env.d.ts postcss.config.mjs drizzle.config.ts ./
COPY src ./src
COPY public ./public
COPY drizzle ./drizzle

RUN mkdir -p /home/vane/data && yarn build


FROM ${RUNTIME_BASE_IMAGE} AS runner

WORKDIR /home/vane

COPY --from=next-builder /home/vane/public ./public
COPY --from=next-builder /home/vane/.next/static ./public/_next/static
COPY --from=next-builder /home/vane/.next/standalone ./
COPY --from=next-builder /home/vane/data ./data
COPY --from=next-builder /home/vane/drizzle ./drizzle

# Playwright is dynamically imported and therefore is not fully traced by Next.js.
COPY --from=next-builder /home/vane/node_modules/playwright ./node_modules/playwright
COPY --from=next-builder /home/vane/node_modules/playwright-core ./node_modules/playwright-core

RUN mkdir -p /home/vane/uploads

# These files remain in the small, frequently changing application layer.
COPY searxng/settings.yml /etc/searxng/settings.yml
COPY searxng/limiter.toml /etc/searxng/limiter.toml
COPY searxng/uwsgi.ini /etc/searxng/uwsgi.ini
RUN chown -R searxng:searxng /etc/searxng

COPY entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh && sed -i 's/\r$//' ./entrypoint.sh

EXPOSE 3000 8080

ENV NODE_OPTIONS="--max-old-space-size=16384"
ENV SEARXNG_API_URL=http://localhost:8080

CMD ["/home/vane/entrypoint.sh"]
